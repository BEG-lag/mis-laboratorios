{
  "name": "mis-laboratorios",
  "version": "1.0.0",
  "private": true,
  "description": "Arrastra los PDF de tus análisis clínicos y grafica cada indicador a lo largo de los años contra el rango del laboratorio. Todo en tu navegador, sin subir nada.",
  "license": "MIT",
  "author": "Benjamín Esponda García (https://pivotek.mx)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check:emdash": "node scripts/check-emdash.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures": "node scripts/fixtures.ts",
    "screenshots": "node scripts/screenshots.ts",
    "icons": "node scripts/icons.ts",
    "check": "npm run typecheck && npm run lint && npm run check:emdash && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "pdf-lib": "^1.17.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
